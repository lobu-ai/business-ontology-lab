diff --git a/packages/server/src/utils/__tests__/event-kind-freshness.test.ts b/packages/server/src/utils/__tests__/event-kind-freshness.test.ts
new file mode 100644
index 000000000..ed4d2247c
--- /dev/null
+++ b/packages/server/src/utils/__tests__/event-kind-freshness.test.ts
@@ -0,0 +1,15 @@
+import {afterEach,beforeEach,describe,expect,it,vi} from 'vitest';
+const state={member:{} as Record<string,unknown>,entity:{} as Record<string,unknown>,query:vi.fn()};
+let primeMemberEventKinds: typeof import('../event-kind-validation').primeMemberEventKinds;
+let validateSaveContentSemanticType: typeof import('../event-kind-validation').validateSaveContentSemanticType;
+let serial=0;
+beforeEach(async()=>{vi.resetModules();vi.doMock('../../db/client',()=>({getDb:()=>state.query}));({primeMemberEventKinds,validateSaveContentSemanticType}=await import('../event-kind-validation'));state.member={note:{}};state.entity={};state.query.mockReset();state.query.mockImplementation(async(strings:TemplateStringsArray)=>[{event_kinds:strings.join('').includes('FROM entities e')?state.entity:state.member}]);});
+afterEach(()=>{vi.doUnmock('../../db/client');vi.resetModules();});
+function org(){return 'freshness-regression-'+(++serial);}
+describe('authoritative event registry validation',()=>{
+ it('accepts a newly declared kind despite a warmed member cache',async()=>{const id=org();primeMemberEventKinds(id,{note:{}});state.member={note:{},new_kind:{}};const result=await validateSaveContentSemanticType('new_kind',{},id,undefined,state.query as never);expect(result.valid).toBe(true);});
+ it('enforces a tightened metadata schema despite a loose cached schema',async()=>{const id=org();primeMemberEventKinds(id,{report:{}});state.member={report:{metadataSchema:{type:'object',required:['source_revision'],properties:{source_revision:{type:'integer'}}}}};const result=await validateSaveContentSemanticType('report',{text:'missing revision'},id,undefined,state.query as never);expect(result.valid).toBe(false);expect(result.errors.join(' ')).toContain('source_revision');});
+ it('rejects a removed kind rather than accepting its stale definition',async()=>{const id=org();primeMemberEventKinds(id,{retired:{}});state.member={note:{}};const result=await validateSaveContentSemanticType('retired',{},id,undefined,state.query as never);expect(result.valid).toBe(false);});
+ it('bypasses cached linked-entity definitions as well as the member registry',async()=>{const id=org();primeMemberEventKinds(id,{note:{}});state.entity={old_kind:{}};await validateSaveContentSemanticType('old_kind',{},id,[42]);state.entity={new_entity_kind:{}};const result=await validateSaveContentSemanticType('new_entity_kind',{},id,[42],state.query as never);expect(result.valid).toBe(true);});
+ it('does not publish a transaction-local registry into the shared cache',async()=>{const id=org();primeMemberEventKinds(id,{note:{}});state.member={note:{},uncommitted:{}};expect((await validateSaveContentSemanticType('uncommitted',{},id,undefined,state.query as never)).valid).toBe(true);expect((await validateSaveContentSemanticType('uncommitted',{},id)).valid).toBe(false);});
+});
