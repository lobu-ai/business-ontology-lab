+export default async function normalize(ctx,client,params){
+ const rows=await client.query("SELECT id,payload_text,metadata FROM events WHERE semantic_type='market_source_document' AND metadata->>'document_type'='inventory' LIMIT 501");
+ if(rows.length>500)throw new Error('Input bound exceeded');
+ const parse=x=>typeof x==='string'?JSON.parse(x):x||{};
+ const old=await client.query("SELECT id,metadata FROM events WHERE semantic_type='market_inventory_observation' LIMIT 501");if(old.length>500)throw new Error('Projection bound exceeded');
+ const key=m=>JSON.stringify([m.source_scope,m.source_record_key,m.statement_slot]);
+ const prior=new Map(old.map(r=>[key(parse(r.metadata)),{id:Number(r.id),metadata:parse(r.metadata)}]));
+ let writes=0;
+ for(const row of rows){const source=parse(row.metadata);const m={demo_suite:'enterprise-marketplace-v1',synthetic:true,source_scope:source.source_scope,source_record_key:source.source_record_key,source_revision:source.source_revision,statement_slot:'stock',status:source.status||'reported',sku:source.sku,warehouse_key:source.warehouse_key||'WH-DEMO',available_quantity:source.available_quantity,as_of:source.as_of||new Date().toISOString(),evidence_event_id:Number(row.id)};
+ const previous=prior.get(key(m));if(previous?.metadata.evidence_event_id===Number(row.id))continue;
+ if(previous&&Number(m.source_revision)<Number(previous.metadata.source_revision))throw new Error('Source revision regression refused by normalizer');
+ const draft={semantic_type:'market_inventory_observation',title:source.sku+' stock report from '+source.source_scope,content:row.payload_text||'Structured stock report',metadata:m,parent_event_id:Number(row.id),idempotency_key:'market-stock:'+row.id};if(previous)draft.supersedes_event_id=previous.id;
+ const saved=await client.knowledge.save(draft);if(saved.approval_queued)throw new Error('Observation requires review');writes++;}
+ const candidates=params?.reconcile_automation_id ? null : (await client.automations.list({})).automations; const found=candidates?.find(a=>a.slug==='market-reconcile'); const target=params?.reconcile_automation_id ?? found?.id ?? found?.automation_id; if(!target)throw new Error('Reconciliation Automation is missing'); const downstream=await client.automations.trigger({automation_id:String(target)});
+ return {normalized:writes,downstream_run_id:downstream.run_id,automatic_chain:true};
+}
