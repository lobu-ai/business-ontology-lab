+import fs from 'node:fs/promises';
+import {Lobu,state,saveState,ROOT,ORG,writeReport} from './client.mjs';
+import {TYPES,RELATIONSHIPS,KINDS,RECORDS,LINKS,VERSION} from './domain.mjs';
+const c=await Lobu.local();const s=await state();let changes=[];
+function applied(x){if(x.status==='pending_approval'||x.approval_queued||x.blocked_fields)throw Error('Installation gated: '+JSON.stringify(x));return x;}
+const {entity_types:types}=await c.call('entitySchema.listTypes',{list_scope:'organization'});
+const existing=new Set(types.map(x=>x.slug));
+for(const t of TYPES){applied(await c.call(existing.has(t.slug)?'entitySchema.updateType':'entitySchema.createType',t,true));changes.push({type:t.slug,existed:existing.has(t.slug)});}
+const member=(await c.call('entitySchema.getType','$member')).entity_type;
+applied(await c.call('entitySchema.updateType',{slug:'$member',event_kinds:{...(member.event_kinds||{}),...KINDS}},true));
+const {relationship_types:rels}=await c.call('entitySchema.listRelTypes',{list_scope:'organization'});const relSet=new Set(rels.map(x=>x.slug));
+for(const rel of RELATIONSHIPS){if(!relSet.has(rel.slug))applied(await c.call('entitySchema.createRelType',{slug:rel.slug,name:rel.name,description:'Synthetic marketplace native relationship'},true));const rules=(await c.call('entitySchema.listRules',{slug:rel.slug})).rules||[];if(!rules.some(r=>r.source_entity_type_slug===rel.from&&r.target_entity_type_slug===rel.to))applied(await c.call('entitySchema.addRule',{slug:rel.slug,source_entity_type_slug:rel.from,target_entity_type_slug:rel.to},true));}
+const rows=await c.query("SELECT id,slug,entity_type FROM entities WHERE entity_type LIKE 'market-%' LIMIT 100");const bySlug=new Map(rows.map(x=>[x.slug,x]));
