+import fs from 'node:fs/promises';
+import {fileURLToPath} from 'node:url';
+export const ROOT = fileURLToPath(new URL('.', import.meta.url));
+export const BASE = process.env.LOBU_BASE_URL || 'http://127.0.0.1:8787';
+export const ORG = process.env.LOBU_ORG || 'enterprise-ontology';
+if(!/^[a-z0-9-]+$/.test(ORG))throw Error('Invalid workspace slug');
+export const STATE_ROOT = process.env.LOBU_EVAL_STATE_DIR || ROOT+'.runtime/'+ORG+'/';
+await fs.mkdir(STATE_ROOT,{recursive:true});
+export class Lobu {
+ constructor(token,org=ORG,cookie=null) {this.token=token;this.org=org;this.cookie=cookie;}
+ static async local(org=ORG) {
+  const u=new URL(BASE);if(!['localhost','127.0.0.1','[::1]'].includes(u.hostname))throw Error('Local-init requires an explicit loopback base URL');
+  const r=await fetch(BASE+'/api/local-init',{method:'POST',headers:{'content-type':'application/json','x-lobu-client':'enterprise-ontology-eval','origin':BASE},body:'{}'});
+  const d=await r.json();if(!r.ok||!d.session_token)throw Error('local-init failed: '+r.status);
+  const cookies=r.headers.getSetCookie?.()||[];
+  return new Lobu(d.session_token,org,cookies.map(x=>x.split(';')[0]).join('; '));
+ }
+ async raw(path,body,options={}) {
+  const headers={'content-type':'application/json','x-lobu-client':'enterprise-ontology-eval','origin':BASE};
+  if(options.cookie&&this.cookie)headers.cookie=this.cookie;else if(this.token)headers.authorization='Bearer '+this.token;
+  const r=await fetch(BASE+path,{method:options.method||(body===undefined?'GET':'POST'),headers,body:body===undefined?undefined:JSON.stringify(body),signal:AbortSignal.timeout(options.timeout||90000)});
+  const text=await r.text();let data;try{data=JSON.parse(text);}catch{data={text:text.slice(0,1000)};}
+  return {status:r.status,data};
+ }
+ async request(path,body,options={}){const r=await this.raw(path,body,options);if(r.status>=400)throw Object.assign(Error(path+' HTTP '+r.status+' '+JSON.stringify(r.data).slice(0,1200)),{status:r.status,detail:r.data});return r.data;}
+ async sdk(code,write=false){const d=await this.request('/api/'+this.org+'/'+(write?'run_sdk':'query_sdk'),{script:'export default async(ctx,client)=>{'+code+'}',timeout_ms:60000});if(!d.success)throw Object.assign(Error(d.error?.message||JSON.stringify(d)),{code:d.error?.code,detail:d.error});if(d.return_truncated)throw Error('Truncated SDK output');return d.return_value;}
+ async call(method,args,write=false){if(!/^[a-zA-Z]+\.[a-zA-Z]+$/.test(method))throw Error('Invalid method');return this.sdk('return await client.'+method+'('+JSON.stringify(args)+');',write);}
+ async query(sql){return this.sdk('return await client.query('+JSON.stringify(sql)+');');}
+ async save(draft){const r=await this.call('knowledge.save',draft,true);if(r.approval_queued||r.blocked_fields)throw Error('Save gated: '+JSON.stringify(r));return r;}
+}
+export function eventId(x){return Number(x.id||x.event_id||x.content_id||x.event?.id);}
+export async function state(){try{return JSON.parse(await fs.readFile(STATE_ROOT+'state.json','utf8'));}catch(e){if(e.code!=='ENOENT')throw e;return {entities:{},automations:{},events:{},links:{}};}}
+export async function saveState(s){await fs.writeFile(STATE_ROOT+'state.json.tmp',JSON.stringify(s,null,2));await fs.rename(STATE_ROOT+'state.json.tmp',STATE_ROOT+'state.json');}
+export async function writeReport(name,data){await fs.mkdir(STATE_ROOT+'reports',{recursive:true});await fs.writeFile(STATE_ROOT+'reports/'+name+'.json',JSON.stringify(data,null,2));}
+export const sleep=ms=>new Promise(r=>setTimeout(r,ms));
