+import fs from 'node:fs/promises';
+import {spawnSync} from 'node:child_process';
+import {Lobu,ORG,ROOT,state,writeReport} from './client.mjs';
+const owner=await Lobu.local('local-install');
+const orgs=await owner.call('organizations.list',{});
+if(!orgs.some(x=>x.slug===ORG))await owner.request('/api/auth/organization/create',{name:'Enterprise Ontology Evaluation',slug:ORG,metadata:{purpose:'synthetic-enterprise-evaluation'}});
+for(const file of ['install.mjs','setup-workflows.mjs']){const p=spawnSync(process.execPath,[ROOT+file],{stdio:'inherit',env:process.env});if(p.status!==0)process.exit(p.status||1);}
+const c=await Lobu.local(ORG);const s=await state();
+const policy=JSON.parse(await fs.readFile(ROOT+'schema-policy.json','utf8'));
+await c.request('/api/'+ORG+'/agent/'+encodeURIComponent(s.agent)+'/permissions',policy,{method:'PUT',cookie:true});
+const view=await c.call('views.set',{source_code:await fs.readFile(ROOT+'overview.tsx','utf8')},true);
+const report={at:new Date().toISOString(),org:ORG,view:view.view?.key,review_policy_configured:true,credentials_persisted:false};
+await writeReport('bootstrap',report);console.log(JSON.stringify(report));
