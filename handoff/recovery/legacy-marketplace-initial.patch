@@ -0,0 +1,44 @@
+export default async function reconcile(ctx, client) {
+ const version='enterprise-marketplace-v1';
+ const parse=x=>typeof x==='string'?JSON.parse(x):x||{};
+ const literal=x=>"'"+String(x).replace(/'/g,"''")+"'";
+ const bounded=async(sql)=>{const rows=await client.query(sql+' LIMIT 501');if(rows.length>500)throw new Error('Evaluation bound exceeded; partition the input explicitly');return rows;};
+ const orders=await bounded("SELECT id,metadata FROM entities WHERE entity_type='market-order'");
+ const claims=(await bounded("SELECT id,semantic_type,metadata FROM events WHERE semantic_type IN ('market_inventory_observation','market_risk_signal')")).map(r=>({...r,metadata:parse(r.metadata)}));
+ const sourceRows=await bounded("SELECT id FROM events WHERE semantic_type='market_source_document'");
+ const currentSources=new Set(sourceRows.map(r=>Number(r.id)));
+ const results=[];
+ for(const order of orders){
+  const m=parse(order.metadata);const inv=claims.filter(r=>r.semantic_type==='market_inventory_observation'&&r.metadata.sku===m.sku&&r.metadata.status==='reported');
+  const rawRisk=claims.filter(r=>r.semantic_type==='market_risk_signal'&&r.metadata.seller_key===m.seller_key&&r.metadata.status==='reported');
+  const risk=rawRisk.filter(r=>currentSources.has(Number(r.metadata.evidence_event_id)));
+  const staleRisk=rawRisk.length!==risk.length;
+  const activeInv=inv.filter(r=>currentSources.has(Number(r.metadata.evidence_event_id)));
+  const staleInventory=activeInv.length!==inv.length;
+  const quantities=activeInv.map(r=>Number(r.metadata.available_quantity));
+  const conflicting=new Set(quantities).size>1;
+  const available=quantities.length?Math.min(...quantities):0;
+  const score=risk.length?Math.max(...risk.map(r=>Number(r.metadata.risk_score))):0;
+  const reasons=[];let disposition='eligible';
+  if(!quantities.length){reasons.push('No current stock evidence');disposition='review';}
+  if(conflicting){reasons.push('Independent inventory sources disagree');disposition='review';}
+  if(staleRisk||staleInventory){reasons.push('Source changed: re-extraction required');disposition='review';}
+  if(available<Number(m.quantity)){reasons.push('Insufficient conservatively reported stock');disposition='hold';}
+  if(score>=70){reasons.push('High-risk supplier evidence requires investigation');disposition='hold';}
+  else if(score>0){reasons.push('Supplier evidence requires review');if(disposition==='eligible')disposition='review';}
+  if(m.status==='cancelled')disposition='cancelled';
+  if(!reasons.length)reasons.push('Evidence supports fulfillment eligibility; this is not a stock reservation or external action');
+  const evidence=[...activeInv,...risk].map(r=>Number(r.id)).sort((a,b)=>a-b);
+  const sourceIds=[...new Set([...activeInv,...risk].map(r=>Number(r.metadata.evidence_event_id)))].sort((a,b)=>a-b);
+  const signature=JSON.stringify({policy:version,order:m,evidence,sourceIds,staleRisk,staleInventory});
+  const previous=await client.query("SELECT id,metadata FROM events WHERE semantic_type='market_decision' AND metadata->>'order_key'="+literal(m.order_key)+" LIMIT 2");
+  if(previous.length>1)throw new Error('Multiple current decision heads for '+m.order_key);
+  if(previous.length&&parse(previous[0].metadata).input_signature===signature){results.push({order:m.order_key,status:'unchanged',event_id:Number(previous[0].id)});continue;}
+  const metadata={demo_suite:version,synthetic:true,order_key:m.order_key,disposition,available_quantity:available,conflicting,risk_score:score,reasons,evidence_event_ids:evidence,source_event_ids:sourceIds,inventory_sources:activeInv.map(r=>r.metadata.source_scope).sort(),input_signature:signature,policy_revision:version,automation_run_id:ctx.window.run_id};
+  const draft={semantic_type:'market_decision',content:'Advisory decision for '+m.order_key+': '+disposition+'. '+reasons.join('; '),title:m.order_key+' — '+disposition,metadata,entity_ids:[Number(order.id)],idempotency_key:'market-decision:'+m.order_key+':'+ctx.window.run_id};
+  if(previous.length)draft.supersedes_event_id=Number(previous[0].id);
+  if(evidence.length)draft.parent_event_id=evidence[0];
+  const saved=await client.knowledge.save(draft);if(saved.approval_queued)throw new Error('Decision write requires review');results.push({order:m.order_key,status:'updated',event_id:Number(saved.id),disposition});
+ }
+ return {version,results,external_effects:0};
+}
