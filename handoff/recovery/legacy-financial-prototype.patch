+#!/usr/bin/env python3
+"""Publish the three bundled financial-demo views through the local Lobu SDK.
+
+Place apply_demo.py beside this script and the three self-contained .view.tsx
+files in ./views, or pass --views-dir. Compilation is performed by views.set;
+an accepted server response is reported separately from browser verification.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import pathlib
+import re
+import sys
+
+from apply_demo import Lobu
+
+
+VIEW_KEYS = ("finance-demo", "ownership-evidence", "ontology-explorer")
+
+
+def emit(value):
+    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")), flush=True)
+
+
+def load_sources(folder):
+    """Preflight every allowed file before making a publishing call."""
+    sources = []
+    for key in VIEW_KEYS:
+        path = folder / (key + ".view.tsx")
+        source = path.read_text(encoding="utf-8")
+        if not source.strip():
+            raise ValueError(f"Empty bundled view: {path.name}")
+        declaration = re.search(
+            r"export\s+const\s+view\s*=\s*defineView\s*\(\s*\{\s*key\s*:\s*(['\"])(.*?)\1",
+            source,
+        )
+        if not declaration or declaration.group(2) != key:
+            raise ValueError(f"Expected defineView key {key!r} in {path.name}")
+        if re.search(r"\b(?:from\s*|import\s*\()(['\"])(?:\.{1,2}/|/)", source):
+            raise ValueError(f"Local imports remain in {path.name}; publish the self-contained bundle")
+        if source.count("export const view = defineView(") != 1:
+            raise ValueError(f"Expected one view declaration in {path.name}")
+        encoded = source.encode("utf-8")
+        sources.append({"key": key, "filename": path.name, "source": source,
+                        "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest()})
+    return sources
+
+
+def summarize_response(expected_key, result):
+    summary = {"key": expected_key, "server_accepted": True,
+               "server_compile_requested": True, "browser_verified": False}
+    if not isinstance(result, dict):
+        summary["response_type"] = type(result).__name__
+        return summary
+    summary["response_keys"] = sorted(result.keys())
+    view = result.get("view")
+    if isinstance(view, dict) and isinstance(view.get("key"), str):
+        summary["accepted_key"] = view["key"]
+        if view["key"] != expected_key:
+            raise RuntimeError(f"Server returned view key {view['key']!r}; expected {expected_key!r}")
+    for field in ("action", "status", "written", "success", "compiled"):
+        value = result.get(field)
+        if isinstance(value, (bool, int, float)) or isinstance(value, str) and len(value) <= 120:
+            summary[field] = value
+    if result.get("approval_queued") or result.get("blocked_fields"):
+        raise RuntimeError(f"View {expected_key} was queued or blocked; it was not reported as published")
+    # views.set returns written:false for an identical, already installed view.
+    # That idempotent no-op is still a successful publication.
+    if result.get("success") is False or result.get("error") or result.get("errors"):
+        summary["server_accepted"] = False
+        summary["error"] = str(result.get("error") or result.get("errors") or "Server did not report a successful write")[:1000]
+    return summary
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--base-url", required=True, help="Explicit local Lobu URL accepted by apply_demo.Lobu")
+    parser.add_argument("--org", required=True, help="Existing organization slug")
+    parser.add_argument("--views-dir", type=pathlib.Path,
+                        default=pathlib.Path(__file__).resolve().parent / "views")
+    args = parser.parse_args()
+    sources = load_sources(args.views_dir)
+    client = Lobu(args.base_url, args.org)
+    completed = []
+    for source in sources:
+        # Supplying only source_code requests the server's normal compilation.
+        # Do not send compiled_code or override the view key parsed from source.
+        result = client.call("views.set", {"source_code": source["source"]}, write=True)
+        summary = {**summarize_response(source["key"], result),
+                   "file": source["filename"], "bytes": source["bytes"], "sha256": source["sha256"]}
+        emit(summary)
+        if not summary["server_accepted"]:
+            return 1
+        completed.append(source["key"])
+    emit({"status": "server-accepted", "view_keys": completed, "count": len(completed),
+          "compilation": "Requested through views.set with source_code; no compiled bundle was supplied.",
+          "browser_verified": False,
+          "verification_note": "A successful SDK response confirms server acceptance. Browser rendering is verified separately."})
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except Exception as error:
+        emit({"status": "failed", "error_type": type(error).__name__, "error": str(error)[:1500]})
+        sys.exit(1)
