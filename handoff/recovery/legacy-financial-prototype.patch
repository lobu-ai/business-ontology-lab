+  const compact = host.displayMode === "inline";
+  const manifestLoaded = !!demo.data?.[0];
+  const catalogLoaded = !!catalog.data?.[0];
+  const sourceUrl = reference.source_url || (reference.source_repository && reference.commit_sha ? `${reference.source_repository}/tree/${reference.commit_sha}` : reference.release_url) || manifest.source_url;
+  const commit = String(reference.commit_sha || manifest.source_commit || "");
+  const qualityIssues = array(reference.parse_errors).length + array(reference.unresolved_imports).length;
+
+  return <Frame compact={compact}>
+    <header className="fi-header">
+      <div className="fi-heading"><div className="fi-eyebrow">Lobu · Financial ontology lab</div><h1>Financial facts. Meaning. Evidence.</h1><p>Follow a synthetic financial network from ownership and voting rights to instruments, lending and corporate actions. Inspect the FIBO definitions behind the model.</p></div>
+      <div className="fi-header-side"><Badge tone="purple">SYNTHETIC DEMO</Badge><Badge tone="brand">{reference.release_tag || "PINNED FIBO REFERENCE"}</Badge>{compact && <FullscreenButton />}</div>
+    </header>
+
+    <QueryNotice query={demo} noun="demo manifest" empty={!manifestLoaded} />
+    <QueryNotice query={recordQuery} noun="demo record index" empty={!recordQuery.data} />
+    <QueryNotice query={catalog} noun="ontology reference" empty={!catalogLoaded} />
+    {manifestLoaded && <div className="fi-metrics">
+      <Metric label="Parties in the network" value={fmt(Number(counts.companies || 0) + Number(counts.people || 0))} note={`${fmt(counts.companies || 0)} companies · ${fmt(counts.people || 0)} people`} />
+      <Metric label="Live observation identities" value={observations.error || observations.loading && !current.length ? "—" : fmt(current.length)} note={`${fmt(conflicts)} conflicting equity ${conflicts === 1 ? "group" : "groups"} · ${fmt(retractions)} retracted`} />
+      <Metric label="Reference classes & properties" value={catalogLoaded ? fmt(Number(catalogCounts.classes || 0) + Number(catalogCounts.properties || 0)) : "—"} note={catalogLoaded ? `${fmt(catalogCounts.modules || 0)} ontology & module records` : "Reference import not available"} />
+      <Metric label="Imported RDF statements" value={catalogLoaded ? fmt(catalogCounts.axioms || 0) : "—"} note="Source assertions, including restrictions" />
+    </div>}
+    <QueryNotice query={observations} noun="current observations" empty={false} />
+    {current.length > 400 && <div className="fi-note amber">The live summary has reached its 400-observation display budget. Narrow the evidence view before treating these counts as complete.</div>}
+
+    {!compact && <>
+      <div className="fi-toolbar"><NavButton href="data/-/views/ownership-evidence" primary>Explore the financial network →</NavButton><NavButton href="data/-/views/ontology-explorer">Open the full ontology →</NavButton><span className="fi-small fi-muted" style={{ marginLeft: "auto" }}>{fmt(counts.roles || counts.party_roles || records.filter(r => r.type === "party-role").length)} contextual roles · {fmt(counts.structural_relationships ?? counts.relationships ?? 0)} {counts.structural_relationships == null ? "native links" : "structural links"}</span></div>
+      <div className="fi-grid">
+        <Panel title="A guided walkthrough" subtitle="Six business questions connect the reference model to working records.">
+          {scenarios.length ? scenarios.map((scenario, index) => {
