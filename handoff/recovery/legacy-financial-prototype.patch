+    LIMIT ${PAGE_SIZE + 1} OFFSET ${Math.max(0, Math.floor(page)) * PAGE_SIZE}` };
+}
+
+function catalogAxiom(key: string): SqlQuery | null {
+  if (!key) return null;
+  return sql`SELECT item->>'key' AS key, item->>'subject' AS subject,
+    item->>'predicate' AS predicate, item->>'object' AS object,
+    item->>'object_kind' AS object_kind, item->>'source_file' AS source_file
+    FROM events e CROSS JOIN LATERAL jsonb_array_elements(e.metadata->'items') AS item
+    WHERE e.semantic_type = 'ontology_catalog_chunk'
+    AND e.metadata->>'reference_id' = ${REFERENCE_ID}
+    AND e.metadata->>'chunk_kind' = 'axioms' AND item->>'key' = ${key} LIMIT 1`;
+}
+
+function currentObservations(focusId?: number): SqlQuery {
