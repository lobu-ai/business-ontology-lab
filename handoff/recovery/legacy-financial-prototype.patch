+}
+
+function demoRecords(): SqlQuery {
+  return sql`SELECT item->>'key' AS key, (item->>'id')::bigint AS id,
+    item->>'type' AS type, item->>'slug' AS slug, item->>'name' AS name
+    FROM (SELECT metadata FROM events WHERE semantic_type = 'ontology_demo_manifest' ORDER BY id DESC LIMIT 1) m
+    CROSS JOIN LATERAL jsonb_array_elements(m.metadata->'entity_index') AS item
+    ORDER BY item->>'type', item->>'name', item->>'key' LIMIT 500`;
+}
+
+function demoMappings(): SqlQuery {
+  return sql`SELECT item->>'iri' AS iri, item->>'entity_type' AS entity_type,
