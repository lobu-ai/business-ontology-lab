+function selectionProblem(selection?: CollectionSelection): string | null {
+  if (selection?.segment) return "This catalog view cannot resolve the selected saved segment. Clear the collection segment to explore the reference, or use the collection table for that segment.";
+  const unsupported = selection?.filters?.filter(f => !scalarFields.has(f.field)) || [];
+  return unsupported.length ? `The collection filters ${unsupported.map(f => f.field).join(", ")} are not supported by this catalog projection. Clear them or use the collection table.` : null;
+}
+
+function collectionWhere(selection?: CollectionSelection): string {
+  const clauses: string[] = [];
+  for (const f of selection?.filters || []) {
+    if (!scalarFields.has(f.field) || !ops[f.op]) continue;
+    const left = `item->>${escapeLiteral(f.field)}`;
+    if (f.value === null) { clauses.push(`${left} IS ${f.op === "neq" ? "NOT " : ""}NULL`); continue; }
+    // Catalog attributes are strings except the explicitly typed deprecated flag.
+    const typedLeft = f.field === "deprecated" && typeof f.value === "boolean" ? `(${left})::boolean` : left;
+    clauses.push(`${typedLeft} ${ops[f.op]} ${escapeLiteral(typeof f.value === "number" ? String(f.value) : f.value)}`);
+  }
+  return clauses.length ? ` AND ${clauses.join(" AND ")}` : "";
+}
+
+function selectTermFields(detail: boolean): string {
+  const fields = detail ? termFields : ["iri", "label", "definition", "module_code", "domain_code", "maturity", "kind", "code"];
+  return [...fields.map(f => `item->>'${f}' AS ${f}`), ...(detail ? listFields.map(f => `item->'${f}' AS ${f}`) : []), "item->>'deprecated' AS deprecated"].join(", ");
+}
+
+function catalogList({ kind, search, domain, page, selection, mappedIris }: { kind: string; search: string; domain: string; page: number; selection?: CollectionSelection; mappedIris?: string[] }): SqlQuery {
+  const q = search.trim();
+  const hostSearch = selection?.search?.trim() || "";
+  const searchClause = (term: string) => term ? ` AND (lower(item->>'label') LIKE ${escapeLiteral(term.toLowerCase() + "%")} OR item->>'iri' = ${escapeLiteral(term)} OR item->>'code' = ${escapeLiteral(term.toUpperCase())})` : "";
+  return { kind: "sql", text: `SELECT ${selectTermFields(false)}
+    FROM events e CROSS JOIN LATERAL jsonb_array_elements(e.metadata->'items') AS item
+    WHERE e.semantic_type = 'ontology_catalog_chunk'
+    AND e.metadata->>'reference_id' = ${escapeLiteral(REFERENCE_ID)}
+    AND e.metadata->>'chunk_kind' = ${escapeLiteral(kind)}
+    ${domain ? `AND item->>'domain_code' = ${escapeLiteral(domain)}` : ""}
+    ${mappedIris ? `AND item->>'iri' IN (${mappedIris.length ? mappedIris.map(escapeLiteral).join(",") : "NULL"})` : ""}
+    ${searchClause(q)}${searchClause(hostSearch)}${collectionWhere(selection)}
+    ORDER BY lower(COALESCE(item->>'label',item->>'iri')), item->>'iri'
+    LIMIT ${PAGE_SIZE + 1} OFFSET ${Math.max(0, Math.floor(page)) * PAGE_SIZE}` };
+}
+
+function catalogTerm(iri: string): SqlQuery | null {
+  if (!iri || iri.startsWith("_:")) return null;
+  return { kind: "sql", text: `SELECT ${selectTermFields(true)}, e.metadata->>'chunk_kind' AS chunk_kind
+    FROM events e CROSS JOIN LATERAL jsonb_array_elements(e.metadata->'items') AS item
+    WHERE e.semantic_type = 'ontology_catalog_chunk'
+    AND e.metadata->>'reference_id' = ${escapeLiteral(REFERENCE_ID)}
+    AND e.metadata->>'chunk_kind' IN ('classes','properties','individuals','modules')
+    AND (e.metadata->>'iri_min' IS NULL OR e.metadata->>'iri_min' <= ${escapeLiteral(iri)})
+    AND (e.metadata->>'iri_max' IS NULL OR e.metadata->>'iri_max' >= ${escapeLiteral(iri)})
+    AND item->>'iri' = ${escapeLiteral(iri)} LIMIT 2` };
+}
+
+function catalogStatements(subject: string, page: number, selection?: CollectionSelection): SqlQuery | null {
+  if (!subject) return null;
+  const query = sql`SELECT item->>'key' AS key, item->>'subject' AS subject,
+    item->>'predicate' AS predicate, item->>'object' AS object,
+    item->>'object_kind' AS object_kind, item->>'datatype' AS datatype,
+    item->>'language' AS language, item->>'module_iri' AS module_iri,
+    item->>'source_file' AS source_file
+    FROM events e CROSS JOIN LATERAL jsonb_array_elements(e.metadata->'items') AS item
+    WHERE e.semantic_type = 'ontology_catalog_chunk'
+    AND e.metadata->>'reference_id' = ${REFERENCE_ID}
+    AND e.metadata->>'chunk_kind' = 'axioms'
+    AND (e.metadata->>'subject_min' IS NULL OR e.metadata->>'subject_min' <= ${subject})
+    AND (e.metadata->>'subject_max' IS NULL OR e.metadata->>'subject_max' >= ${subject})
+    AND item->>'subject' = ${subject}`;
+  return { kind: "sql", text: query.text + collectionWhere(selection) + `
+    ORDER BY item->>'predicate', item->>'object', item->>'key'
+    LIMIT ${PAGE_SIZE + 1} OFFSET ${Math.max(0, Math.floor(page)) * PAGE_SIZE}` };
+}
+
+function catalogAxiom(key: string): SqlQuery | null {
+  if (!key) return null;
+  return sql`SELECT item->>'key' AS key, item->>'subject' AS subject,
+    item->>'predicate' AS predicate, item->>'object' AS object,
+    item->>'object_kind' AS object_kind, item->>'source_file' AS source_file
+    FROM events e CROSS JOIN LATERAL jsonb_array_elements(e.metadata->'items') AS item
+    WHERE e.semantic_type = 'ontology_catalog_chunk'
+    AND e.metadata->>'reference_id' = ${REFERENCE_ID}
+    AND e.metadata->>'chunk_kind' = 'axioms' AND item->>'key' = ${key} LIMIT 1`;
+}
+
+function currentObservations(focusId?: number): SqlQuery {
+  return sql`SELECT e.id AS event_id, COALESCE(e.identity_key,e.metadata->>'logical_observation_key') AS key, e.title AS name,
+    e.semantic_type, e.metadata->>'source_scope' AS source_scope,
+    e.metadata->>'source_revision' AS source_revision,
+    e.metadata->>'status' AS status, e.metadata->>'review_status' AS review_status,
+    e.metadata->>'as_of' AS as_of, e.metadata->>'basis' AS basis,
+    e.metadata->>'share_class' AS share_class, e.metadata->>'percentage' AS percentage,
+    e.metadata->>'quantity' AS quantity, e.metadata->>'currency' AS currency,
+    COALESCE(e.metadata->>'principal',e.metadata->>'principal_amount') AS principal,
+    COALESCE(e.metadata->>'rate',e.metadata->>'annual_interest_percent') AS rate,
+    e.metadata->>'action_type' AS action_type, e.metadata->>'action_status' AS action_status,
+    e.metadata->>'effective_date' AS effective_date, e.metadata->>'ratio_numerator' AS ratio_numerator,
+    e.metadata->>'ratio_denominator' AS ratio_denominator,
+    e.metadata->>'issued_units_before' AS issued_units_before, e.metadata->>'issued_units_after' AS issued_units_after,
+    e.metadata->>'control_basis' AS control_basis, e.metadata->>'appointable_board_seats' AS appointable_board_seats,
+    e.metadata->>'total_board_seats' AS total_board_seats, e.metadata->>'maturity_date' AS maturity_date,
+    e.metadata->>'valid_from' AS valid_from, e.metadata->>'valid_to' AS valid_to,
+    e.metadata->>'quantity_unit' AS quantity_unit, e.metadata->>'change_reason' AS change_reason,
+    e.metadata->>'coupon_per_unit' AS coupon_per_unit,
+    e.metadata->>'loan_key' AS loan_key, e.metadata->>'action_key' AS action_key,
+    e.metadata->>'owner_role_key' AS owner_role_key, e.metadata->>'lender_role_key' AS lender_role_key,
+    e.metadata->>'borrower_role_key' AS borrower_role_key, e.metadata->>'guarantor_role_key' AS guarantor_role_key,
+    e.metadata->>'portfolio_key' AS portfolio_key, e.metadata->>'instrument_key' AS instrument_key,
+    e.metadata->>'decision' AS decision, e.metadata->>'rationale' AS rationale,
+    e.metadata->>'mapping_version' AS mapping_version,
+    e.metadata->>'source_event_id' AS source_event_id,
+    e.metadata->'scenario_keys' AS scenario_keys,
+    owner.entity_type AS owner_type, subject.entity_type AS subject_type,
+    owner.id AS owner_id, owner.name AS owner_name, owner.slug AS owner_slug,
+    subject.id AS subject_id, subject.name AS subject_name, subject.slug AS subject_slug
+    FROM events e
+    LEFT JOIN entities owner ON owner.id = NULLIF(e.metadata->>'owner_entity_id','')::bigint
+    LEFT JOIN entities subject ON subject.id = NULLIF(COALESCE(e.metadata->>'subject_entity_id',e.metadata->>'owned_entity_id'),'')::bigint
+    WHERE e.semantic_type IN ('ownership_observation','voting_observation','control_observation','holding_observation','loan_observation','corporate_action_observation','review_decision')
+    AND e.metadata->>'mapping_version' IN ('financial-ontology-demo-v2','ownership-demo-v1')
+    AND (${focusId ?? null} IS NULL OR owner.id = ${focusId ?? null} OR subject.id = ${focusId ?? null})
+    ORDER BY e.id DESC LIMIT 401`;
+}
+
+function selectedCollection(scope: Scope): string | null {
+  if (!scope.collection || !scope.type) return null;
+  const input = { entity_type: scope.type, ...scope.collection, limit: 500, offset: 0 };
+  return `export default async (_ctx, client) => { const result = await client.entities.list(${JSON.stringify(input)}); return { entities: result.entities, metadata: result.metadata }; };`;
+}
+
+// ---- finance-demo.tsx ----
+
+export const view = defineView({
+  key: "finance-demo",
+  name: "Financial ontology lab",
+  description: "Guided financial scenarios, live claims and explicit FIBO reference coverage.",
+  attach: [{ workspace: true }],
+});
+
+function active(row: Json) { return !["retracted", "superseded", "rejected"].includes(String(row.status || "")); }
+function conflictCount(rows: Json[]) {
+  const groups = new Map<string, Set<string>>();
+  for (const r of rows.filter(r => active(r) && r.semantic_type === "ownership_observation" && r.percentage != null)) {
+    const key = [r.owner_id, r.subject_id, r.as_of, r.basis, r.share_class].join("|");
+    if (!groups.has(key)) groups.set(key, new Set());
+    groups.get(key)!.add(String(Number(r.percentage)));
+  }
+  return [...groups.values()].filter(values => values.size > 1).length;
+}
+
+function scenarioOutcome(scenario: Json): string {
+  if (typeof scenario.expected === "string") return scenario.expected;
+  if (scenario.expected_summary) return String(scenario.expected_summary);
+  const e = json(scenario.expected);
+  switch (scenario.key) {
+    case "conflicting-sources": return "45% and 47% remain separate ordinary-equity reports; the withdrawn 60% and preferred 20% are visibly distinct.";
+    case "equity-voting-control": return "45% reported equity, 72% voting rights and a separately evidenced board-appointment agreement coexist.";
+    case "indirect-paths": return "The 45% and 47% source branches produce conditional 27% and 28.2% two-step path products; direct interests stay separate.";
+    case "split-and-holdings": return "The ordinary-share holding changes from 1,000 to 2,000 after a 2-for-1 split; preferred shares remain unchanged.";
+    case "instruments-and-loans": return "The USD 2m loan, its 4.5% interest terms, Cedar’s separate bond and the portfolio’s coupon entitlement retain their own identities.";
+    case "correction-and-review": return "A source correction changes 78% to 80% without inventing a purchase; the review is visibly simulated.";
+    default: return typeof e.description === "string" ? e.description : "Follow the source claims, their subjects and exact evidence versions.";
+  }
+}
+
