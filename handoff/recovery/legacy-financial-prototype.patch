+    e.metadata->>'owner_role_key' AS owner_role_key, e.metadata->>'lender_role_key' AS lender_role_key,
+    e.metadata->>'borrower_role_key' AS borrower_role_key, e.metadata->>'guarantor_role_key' AS guarantor_role_key,
+    e.metadata->>'portfolio_key' AS portfolio_key, e.metadata->>'instrument_key' AS instrument_key,
