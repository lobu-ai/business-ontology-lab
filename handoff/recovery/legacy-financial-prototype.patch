+    item->>'scope' AS scope
+    FROM (SELECT metadata FROM events WHERE semantic_type = 'ontology_demo_manifest' ORDER BY id DESC LIMIT 1) m
+    CROSS JOIN LATERAL jsonb_array_elements(m.metadata->'mappings') AS item
+    ORDER BY item->>'iri', item->>'entity_type' LIMIT 500`;
+}
+
+function catalogManifest(): SqlQuery {
+  return sql`SELECT id, metadata->'counts' AS counts, metadata->'domains' AS domains,
+    metadata->>'reference_id' AS reference_id, metadata->>'release_tag' AS release_tag,
+    metadata->>'commit_sha' AS commit_sha, metadata->>'source_url' AS source_url,
+    metadata->>'source_repository' AS source_repository, metadata->>'release_url' AS release_url,
+    metadata->'chunk_counts' AS chunk_counts,
+    metadata->>'all_source_documents_parsed' AS all_source_documents_parsed,
+    metadata->>'complete_import_closure' AS complete_import_closure,
+    metadata->'parse_errors' AS parse_errors,
+    metadata->'unresolved_imports' AS unresolved_imports
+    FROM events WHERE semantic_type = 'ontology_catalog_manifest'
+    AND metadata->>'reference_id' = ${REFERENCE_ID} ORDER BY id DESC LIMIT 1`;
+}
+
+const termFields = ["iri", "label", "definition", "module_iri", "module_code", "domain_code", "namespace", "maturity", "source_file", "source_url", "code", "kind", "external"];
+const listFields = ["synonyms", "types", "parents", "domain", "range", "inverse", "source_files", "equivalent", "disjoint", "restrictions", "imports", "characteristics", "definitions"];
+const scalarFields = new Set([...termFields, "deprecated", "subject", "predicate", "object", "object_kind", "datatype", "language", "key"]);
+const ops: Record<string, string> = { eq: "=", neq: "<>", lt: "<", lte: "<=", gt: ">", gte: ">=" };
+
+function selectionProblem(selection?: CollectionSelection): string | null {
+  if (selection?.segment) return "This catalog view cannot resolve the selected saved segment. Clear the collection segment to explore the reference, or use the collection table for that segment.";
+  const unsupported = selection?.filters?.filter(f => !scalarFields.has(f.field)) || [];
+  return unsupported.length ? `The collection filters ${unsupported.map(f => f.field).join(", ")} are not supported by this catalog projection. Clear them or use the collection table.` : null;
+}
+
+function collectionWhere(selection?: CollectionSelection): string {
+  const clauses: string[] = [];
+  for (const f of selection?.filters || []) {
+    if (!scalarFields.has(f.field) || !ops[f.op]) continue;
+    const left = `item->>${escapeLiteral(f.field)}`;
+    if (f.value === null) { clauses.push(`${left} IS ${f.op === "neq" ? "NOT " : ""}NULL`); continue; }
+    // Catalog attributes are strings except the explicitly typed deprecated flag.
+    const typedLeft = f.field === "deprecated" && typeof f.value === "boolean" ? `(${left})::boolean` : left;
+    clauses.push(`${typedLeft} ${ops[f.op]} ${escapeLiteral(typeof f.value === "number" ? String(f.value) : f.value)}`);
+  }
+  return clauses.length ? ` AND ${clauses.join(" AND ")}` : "";
+}
+
+function selectTermFields(detail: boolean): string {
+  const fields = detail ? termFields : ["iri", "label", "definition", "module_code", "domain_code", "maturity", "kind", "code"];
+  return [...fields.map(f => `item->>'${f}' AS ${f}`), ...(detail ? listFields.map(f => `item->'${f}' AS ${f}`) : []), "item->>'deprecated' AS deprecated"].join(", ");
