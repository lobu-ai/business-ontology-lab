+
+const REFERENCE_ID = "fibo-2026q3";
+const PAGE_SIZE = 30;
+
+function demoManifest(): SqlQuery {
+  return sql`SELECT id, metadata->'demo_counts' AS demo_counts,
+    metadata->'scenarios' AS scenarios, metadata->'coverage' AS coverage,
+    metadata->>'catalog_version' AS catalog_version,
+    metadata->>'source_commit' AS source_commit, metadata->>'source_url' AS source_url
