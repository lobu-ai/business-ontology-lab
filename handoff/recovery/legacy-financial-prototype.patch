+              <div><h3>{scenario.title}</h3><p>{scenario.question}</p>{scenario.expected && <div className="expected"><strong>Look for:</strong> {scenarioOutcome(scenario)}</div>}{targets.length > 1 && <div className="fi-row" style={{ marginTop: 9 }}>{targets.slice(1, 4).map(target => <NavButton key={target.key} href={recordPath(target)} quiet>{target.name} ↗</NavButton>)}</div>}</div>
+              {targets[0] && <NavButton href={recordPath(targets[0])} small>Open scenario ↗</NavButton>}
