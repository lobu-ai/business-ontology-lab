diff --git a/packages/server/src/utils/__tests__/event-kind-freshness.test.ts b/packages/server/src/utils/__tests__/event-kind-freshness.test.ts
new file mode 100644
index 000000000..a979be85b
--- /dev/null
+++ b/packages/server/src/utils/__tests__/event-kind-freshness.test.ts
@@ -0,0 +1,82 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { DbClient } from '../../db/client';
+
+const state = {
+  member: {} as Record<string, unknown>,
+  entity: {} as Record<string, unknown>,
+  query: vi.fn(),
+};
+let api: typeof import('../event-kind-validation');
+let serial = 0;
+
+beforeEach(async () => {
+  vi.resetModules();
+  state.member = { note: {} };
+  state.entity = {};
+  state.query.mockReset();
+  state.query.mockImplementation(async (strings: TemplateStringsArray) => [{
+    event_kinds: strings.join('').includes('FROM entities e') ? state.entity : state.member,
+  }]);
+  vi.doMock('../../db/client', () => ({ getDb: () => state.query }));
+  api = await import('../event-kind-validation');
+});
+
+afterEach(() => {
+  vi.doUnmock('../../db/client');
+  vi.resetModules();
+});
+
+function organization() { return 'freshness-regression-' + (++serial); }
+function transaction() { return state.query as unknown as DbClient; }
+
+describe('authoritative event registry validation', () => {
+  it('accepts a newly declared kind despite a warmed member cache', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { note: {} });
+    state.member = { note: {}, new_kind: {} };
+    const result = await api.validateSaveContentSemanticType('new_kind', {}, org, undefined, transaction());
+    expect(result.valid).toBe(true);
+  });
+
+  it('ordinary saves and action validation do not need an explicit transaction to see changes', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { note: {} });
+    state.member = { note: {}, new_kind: {} };
+    expect((await api.validateSaveContentSemanticType('new_kind', {}, org)).valid).toBe(true);
+  });
+
+  it('enforces tightened metadata instead of a loose cached schema', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { report: {} });
+    state.member = { report: { metadataSchema: {
+      type: 'object', required: ['source_revision'],
+      properties: { source_revision: { type: 'integer' } },
+    } } };
+    const result = await api.validateSaveContentSemanticType('report', { text: 'missing revision' }, org, undefined, transaction());
+    expect(result.valid).toBe(false);
+    expect(result.errors.join(' ')).toContain('source_revision');
+  });
+
+  it('rejects a removed kind rather than accepting its cached definition', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { retired: {} });
+    expect((await api.validateSaveContentSemanticType('retired', {}, org)).valid).toBe(false);
+  });
+
+  it('bypasses linked-entity caches as well as the member cache', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { note: {} });
+    state.entity = { old_kind: {} };
+    await api.resolveEventKindDefinition('old_kind', org, [42]);
+    state.entity = { new_entity_kind: {} };
+    expect((await api.validateSaveContentSemanticType('new_entity_kind', {}, org, [42], transaction())).valid).toBe(true);
+  });
+
+  it('does not publish transaction-local definitions into the rendering cache', async () => {
+    const org = organization();
+    api.primeMemberEventKinds(org, { note: {} });
+    state.member = { note: {}, uncommitted: {} };
+    expect((await api.validateSaveContentSemanticType('uncommitted', {}, org, undefined, transaction())).valid).toBe(true);
+    expect(await api.resolveEventKindDefinition('uncommitted', org)).toBeNull();
+  });
+});
