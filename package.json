{
  "name": "@lobu/ontology-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible operational ontology profiles built with Lobu native primitives",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25 || >=26"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap": "node profiles/marketplace/scripts/bootstrap.mjs",
    "verify:live": "node profiles/marketplace/tests/lifecycle.mjs",
    "validate": "cd profiles/marketplace && lobu validate",
    "llm:prepare": "node profiles/marketplace/scripts/llm.mjs prepare",
    "llm:complete": "node profiles/marketplace/scripts/llm.mjs complete",
    "verify:access": "node profiles/marketplace/tests/access.mjs",
    "verify:governance": "node profiles/marketplace/tests/governance.mjs",
    "verify:ordering": "node profiles/marketplace/tests/ordering.mjs",
    "verify:readonly": "node scripts/verify-readonly.mjs",
    "verify:feedback": "node profiles/marketplace/tests/feedback.mjs",
    "verify:source-binding": "node profiles/marketplace/tests/source-binding.mjs",
    "verify:repair": "node profiles/marketplace/tests/repair.mjs",
    "verify:governed-eval": "node profiles/marketplace/tests/governed-eval.mjs",
    "eval:score": "node evals/supplier-risk/score.mjs",
    "eval:compare": "node evals/supplier-risk/compare.mjs",
    "eval:govern": "node evals/supplier-risk/govern.mjs"
  },
  "devDependencies": {
    "@lobu/cli": "24.1.1",
    "esbuild": "0.28.1",
    "prettier": "3.6.2"
  }
}
